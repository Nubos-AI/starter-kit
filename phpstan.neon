includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/keepsuit/laravel-temporal/extension.neon
    - phpstan-packages.php

services:
    -
        class: App\Support\Temporal\WorkflowProxySignalQueryExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension

parameters:
    databaseMigrationsPath:
        - database/migrations
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/Fixtures/

    level: 7
