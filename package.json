{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write --no-error-on-unmatched-pattern resources/ vite.config.ts vitest.config.ts packages/*/*/resources/ packages/*/*/tests/Frontend/",
        "format:check": "prettier --check --no-error-on-unmatched-pattern resources/ vite.config.ts vitest.config.ts packages/*/*/resources/ packages/*/*/tests/Frontend/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "types:check": "vue-tsc --noEmit -p tsconfig.types.json"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.11",
        "axe-core": "^4.12.1",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.9",
        "vitest-axe": "^0.1.0",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.17.0",
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/core": "^1.48.2",
        "@vueuse/core": "^14.4.0",
        "ag-charts-community": "14.1.0",
        "ag-charts-vue3": "14.1.0",
        "ag-grid-community": "36.0.0",
        "ag-grid-vue3": "36.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "reka-ui": "^2.9.8",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.32",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "version": "0.3.0"
}
